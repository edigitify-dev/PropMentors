# PostgreSQL connection. Include provider-required SSL parameters in production.
# For hosted PostgreSQL, use sslmode=verify-full to verify the certificate and hostname.
DATABASE_URL=postgresql://username:password@localhost:5432/propmentors

# One-time key to create the first administrator at /admin/setup.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_TOKEN=

# Canonical website origin in production, e.g. https://propmentors.com.
# Leave empty for local development.
APP_URL=

# Enable only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=false

# Legacy Cloudinary account, retained only for recovery of earlier uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare R2. Credentials stay on the server; the public URL serves images.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
